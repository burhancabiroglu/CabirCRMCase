<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ViteDistFiles Include="dist\**\*.*" />
    </ItemGroup>

    <Target Name="ViteBuild" BeforeTargets="Build">
        <Exec Command="npm install" />
        <Exec Command="npm run build" />
        <RemoveDir Directories="..\CabirCRM.API\wwwroot" />
        <MakeDir Directories="..\CabirCRM.API\wwwroot" />
        <Copy SourceFiles="@(ViteDistFiles)" DestinationFolder="..\CabirCRM.API\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>
